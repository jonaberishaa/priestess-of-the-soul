# Gmail SMTP — used for order, contact form, and newsletter emails
# For Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
SMTP_USER=jonaberishaa@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Admin panel login (choose your own values, do not reuse elsewhere)
ADMIN_USERNAME=changeme
ADMIN_PASSWORD=changeme

# Random long string used to sign admin session cookies, e.g: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Postgres — auto-populated when you add the Neon integration via the Vercel Marketplace
POSTGRES_URL=
